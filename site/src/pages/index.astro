---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeedbackModal from '../components/FeedbackModal.astro';
---

<BaseLayout title="Browse Plans">
  <Hero />
  <FeedbackModal />

  <div class="container-wide page-body">
    <!-- Controls: sort + filters on top, search below -->
    <div class="controls">
      <div class="controls-top">
        <div class="ctrl-group">
          <span class="ctrl-label" aria-hidden="true">Sort</span>
          <select id="sort-select" class="filter-select" aria-label="Sort results">
            <option value="shuffle">Shuffle</option>
            <option value="year-desc">Newest</option>
            <option value="year-asc">Oldest</option>
            <option value="title-asc">Title A→Z</option>
            <option value="title-desc">Title Z→A</option>
          </select>
        </div>
        <div class="ctrl-divider" aria-hidden="true"></div>
        <div class="ctrl-group">
          <span class="ctrl-label" aria-hidden="true">Filters</span>
          <div class="filters">
            <select id="filter-country" class="filter-select" aria-label="Filter by country">
              <option value="">All countries</option>
            </select>
            <select id="filter-city" class="filter-select" aria-label="Filter by city">
              <option value="">All cities</option>
            </select>
            <select id="filter-lang" class="filter-select" aria-label="Filter by language">
              <option value="">All languages</option>
            </select>
            <select id="filter-year" class="filter-select" aria-label="Filter by year">
              <option value="">All years</option>
            </select>
          </div>
        </div>
        <button class="clear-all" id="clear-all" hidden>Clear all</button>
      </div>
      <div class="controls-bottom">
        <div class="search-wrap">
          <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input
            type="search"
            id="search-input"
            placeholder="Search by title, city, or country…"
            autocomplete="off"
          />
          <button class="search-clear" id="search-clear" aria-label="Clear search" hidden>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Status line -->
    <div id="results-status" class="results-status" aria-live="polite"></div>

    <!-- Document grid — populated by client script -->
    <div id="docs-grid" class="docs-grid" aria-label="Documents"></div>

    <!-- Pagination — populated by client script -->
    <div id="pagination" class="pagination-wrap"></div>
  </div>
</BaseLayout>

<style>
  .page-body {
    padding-top: var(--sp-6);
    padding-bottom: var(--sp-9);
  }

  /* ---- Controls ---- */
  .controls {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    margin-bottom: var(--sp-5);
  }

  .controls-top {
    display: flex;
    gap: var(--sp-3);
    align-items: center;
    flex-wrap: wrap;
  }

  .controls-bottom {
    display: flex;
  }

  .ctrl-group {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .ctrl-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-4);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .ctrl-divider {
    width: 1px;
    height: 1.75em;
    background: var(--border-hair);
    flex-shrink: 0;
    margin: 0 var(--sp-1);
  }

  .search-wrap {
    position: relative;
    flex: 1;
    min-width: 0;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--fg-4);
    pointer-events: none;
  }

  #search-input {
    width: 100%;
    padding: var(--sp-3) 36px var(--sp-3) 38px;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  #search-input::-webkit-search-cancel-button {
    display: none;
  }

  .search-clear {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    padding: 4px;
    cursor: pointer;
    color: var(--fg-4);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-sm);
    transition: color var(--dur-fast) var(--ease-standard);
  }

  .search-clear:hover { color: var(--fg-1); }
  .search-clear[hidden] { display: none; }

  .filters {
    display: flex;
    gap: var(--sp-2);
    flex-wrap: wrap;
    align-items: center;
  }

  .filter-select {
    padding: var(--sp-2) var(--sp-3);
    font-size: 0.875rem;
    cursor: pointer;
  }

  .clear-all {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--fg-4);
    cursor: pointer;
    white-space: nowrap;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    transition: color var(--dur-fast) var(--ease-standard);
    flex-shrink: 0;
  }

  .clear-all:hover { color: var(--fg-1); }
  .clear-all[hidden] { display: none; }

  /* ---- Status line ---- */
  .results-status {
    font-size: 0.8125rem;
    color: var(--fg-4);
    font-family: var(--font-mono);
    letter-spacing: 0.03em;
    margin-bottom: var(--sp-4);
    min-height: 1.4em;
  }

  /* ---- Document grid ---- */
  .docs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--sp-4);
  }

  .docs-grid.search-mode {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--sp-5);
  }

  /* ---- Card ---- */
  :global(.doc-card) {
    background: var(--bg-2);
    border: 1px solid var(--border-hair);
    border-radius: var(--r-lg);
    overflow: hidden;
    transition: box-shadow var(--dur-fast) var(--ease-standard),
                transform var(--dur-fast) var(--ease-standard);
  }

  :global(.doc-card:hover) {
    box-shadow: var(--shadow-2);
    transform: translateY(-2px);
  }

  :global(.doc-thumb-wrap) {
    display: block;
    width: 100%;
    aspect-ratio: 8.5 / 11;
    overflow: hidden;
    background: var(--bg-3);
    text-decoration: none;
  }

  :global(.doc-thumb) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-base) var(--ease-standard);
    display: block;
  }

  :global(.doc-card:hover .doc-thumb) {
    transform: scale(1.04);
  }

  :global(.doc-thumb-placeholder) {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fg-4);
  }

  :global(.doc-body) {
    padding: var(--sp-3);
  }

  :global(.doc-title) {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: var(--sp-1);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--fg-1);
  }

  :global(.doc-title a) {
    color: inherit;
    text-decoration: none;
  }

  :global(.doc-title a:hover) {
    color: var(--carnelian);
    text-decoration: none;
  }

  :global(.doc-location) {
    font-size: 0.75rem;
    color: var(--fg-3);
    margin-bottom: var(--sp-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.4;
  }

  :global(.doc-meta) {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    margin-top: var(--sp-1);
  }

  :global(.doc-meta-item) {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    color: var(--fg-4);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  :global(.doc-meta-sep) {
    font-size: 0.5rem;
    color: var(--fg-4);
    opacity: 0.5;
  }

  :global(.doc-card) {
    position: relative;
  }


  :global(.doc-report-btn) {
    position: absolute;
    bottom: var(--sp-2);
    right: var(--sp-2);
    background: none;
    border: none;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fg-4);
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-standard),
                color var(--dur-fast) var(--ease-standard);
  }

  :global(.doc-card:hover .doc-report-btn) {
    opacity: 1;
  }

  :global(.doc-report-btn:hover) {
    color: var(--carnelian);
  }

  /* ---- Empty / loading states ---- */
  :global(.state-message) {
    grid-column: 1 / -1;
    padding: var(--sp-9) var(--sp-5);
    text-align: center;
    color: var(--fg-4);
    font-size: 0.9375rem;
  }

  :global(.loading-state) {
    grid-column: 1 / -1;
    padding: var(--sp-9) 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3);
    color: var(--fg-4);
    font-size: 0.875rem;
  }

  /* ---- Pagination ---- */
  .pagination-wrap {
    margin-top: var(--sp-7);
  }

  :global(.pagination-inner) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }

  :global(.page-info) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--fg-4);
    min-width: 80px;
    text-align: center;
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .docs-grid {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: var(--sp-3);
    }
  }

  @media (max-width: 600px) {
    .controls-top {
      flex-direction: column;
      align-items: stretch;
    }

    .ctrl-group {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--sp-1);
    }

    .ctrl-divider {
      display: none;
    }

    .filters {
      flex-direction: column;
      align-items: stretch;
    }

    .filter-select {
      width: 100%;
    }

    .docs-grid {
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: var(--sp-3);
    }
  }
</style>

<script>
  import { supabase, getPublicUrl, type Document, type SearchResult } from '../lib/supabase';

  async function loadStats() {
    const { data } = await supabase.rpc('get_document_stats');
    const row = Array.isArray(data) ? data[0] : data;
    if (!row) return;
    const fmt = (n: number) => n.toLocaleString();
    document.getElementById('stat-plans')!.textContent     = fmt(row.total_documents || 0);
    document.getElementById('stat-cities')!.textContent    = fmt(row.total_cities    || 0);
    document.getElementById('stat-countries')!.textContent = fmt(row.total_countries || 0);
  }

  const ROWS = 5;
  let colCount = 4; // updated before every fetch

  // Mirrors the CSS grid breakpoints so PER_PAGE is always cols × ROWS.
  function detectColCount(): number {
    const w = grid.clientWidth;
    let minCell: number;
    let gap: number;
    if (w <= 600)             { minCell = 140; gap = 12; }
    else if (w <= 900)        { minCell = 150; gap = 12; }
    else if (isHybridSearch)  { minCell = 260; gap = 24; }
    else                      { minCell = 180; gap = 16; }
    return Math.max(1, Math.floor((w + gap) / (minCell + gap)));
  }

  function getPerPage(): number { return colCount * ROWS; }

  // State
  let currentPage = 1;
  let currentSearch = '';
  let currentCountry = '';
  let currentCity = '';
  let currentLang = '';
  let currentYear = '';
  let currentSort = 'shuffle';
  let totalCount = 0;
  let filterOptionsLoaded = false;

  // Hybrid search state
  let isHybridSearch = false;
  type ChunkInfo = { content: string; page: number | null; vector_rank: number | null; keyword_rank: number | null };
  const chunkInfoMap = new Map<string, ChunkInfo>();

  // Store metadata for cascading city filter
  const cityMap = new Map<string, string[]>(); // iso3 → sorted city names

  // DOM refs
  const searchInput   = document.getElementById('search-input')   as HTMLInputElement;
  const searchClear   = document.getElementById('search-clear')   as HTMLButtonElement;
  const clearAllBtn   = document.getElementById('clear-all')      as HTMLButtonElement;
  const countrySelect = document.getElementById('filter-country') as HTMLSelectElement;
  const citySelect    = document.getElementById('filter-city')    as HTMLSelectElement;
  const langSelect    = document.getElementById('filter-lang')    as HTMLSelectElement;
  const yearSelect    = document.getElementById('filter-year')    as HTMLSelectElement;
  const sortSelect    = document.getElementById('sort-select')    as HTMLSelectElement;
  const grid          = document.getElementById('docs-grid')       as HTMLDivElement;
  const statusEl      = document.getElementById('results-status')  as HTMLDivElement;
  const paginationEl  = document.getElementById('pagination')      as HTMLDivElement;

  function syncClearButton() {
    searchClear.hidden = searchInput.value === '';
  }

  function syncClearAll() {
    clearAllBtn.hidden = !(currentSearch || currentCountry || currentCity || currentLang || currentYear);
  }

  /* ── URL state ──────────────────────────────────────────────── */

  function readUrl() {
    const p = new URLSearchParams(window.location.search);
    currentSearch  = p.get('q')       || '';
    currentCountry = p.get('country') || '';
    currentCity    = p.get('city')    || '';
    currentLang    = p.get('lang')    || '';
    currentYear    = p.get('year')    || '';
    currentSort    = p.get('sort')    || 'shuffle';
    currentPage    = parseInt(p.get('page') || '1');
  }

  function pushUrl() {
    const p = new URLSearchParams();
    if (currentSearch)           p.set('q',       currentSearch);
    if (currentCountry)          p.set('country', currentCountry);
    if (currentCity)             p.set('city',    currentCity);
    if (currentLang)             p.set('lang',    currentLang);
    if (currentYear)             p.set('year',    currentYear);
    if (currentSort !== 'shuffle') p.set('sort',  currentSort);
    if (currentPage > 1)         p.set('page',    String(currentPage));
    const qs = p.toString();
    window.history.pushState({}, '', qs ? `/?${qs}` : '/');
  }

  /* ── Filter options ─────────────────────────────────────────── */

  async function loadFilterOptions() {
    const { data, error } = await supabase
      .from('documents')
      .select('metadata')
      .eq('doc_type', 'adaptation_plan');

    if (error || !data) return;

    // Extract unique countries and build city map
    const countries = new Map<string, string>(); // iso3 → name
    const langSet   = new Set<string>();

    for (const { metadata: m } of data) {
      if (!m) continue;
      if (m.country_iso3 && m.country_name) {
        countries.set(m.country_iso3, m.country_name);
        if (m.city_name) {
          if (!cityMap.has(m.country_iso3)) cityMap.set(m.country_iso3, []);
          const cities = cityMap.get(m.country_iso3)!;
          if (!cities.includes(m.city_name)) cities.push(m.city_name);
        }
      }
      if (m.language) langSet.add(m.language);
    }

    // Sort city lists
    cityMap.forEach((cities, iso3) => cityMap.set(iso3, cities.sort((a, b) => a.localeCompare(b))));

    // Populate country select
    const sortedCountries = [...countries.entries()].sort((a, b) => a[1].localeCompare(b[1]));
    for (const [iso3, name] of sortedCountries) {
      const opt = document.createElement('option');
      opt.value = iso3;
      opt.textContent = name;
      countrySelect.appendChild(opt);
    }

    // Populate language select
    const LANG_LABELS: Record<string, string> = {
      'ar': 'Arabic', 'ca': 'Catalan', 'cy': 'Welsh', 'de': 'German',
      'el': 'Greek', 'en': 'English', 'es': 'Spanish', 'fi': 'Finnish',
      'fr': 'French', 'he': 'Hebrew', 'id': 'Indonesian', 'ja': 'Japanese',
      'ko': 'Korean', 'nl': 'Dutch', 'no': 'Norwegian', 'pl': 'Polish',
      'pt': 'Portuguese', 'ro': 'Romanian', 'ru': 'Russian', 'tl': 'Filipino',
      'tr': 'Turkish', 'uk': 'Ukrainian', 'zh-cn': 'Chinese',
    };
    for (const lang of [...langSet].sort()) {
      const opt = document.createElement('option');
      opt.value = lang;
      opt.textContent = LANG_LABELS[lang] ?? lang.toUpperCase();
      langSelect.appendChild(opt);
    }

    // Collect years
    const yearSet = new Set<number>();
    for (const { metadata: m } of data) {
      const y = m?.year;
      if (y && typeof y === 'number' && y > 1900 && y <= new Date().getFullYear() + 1) {
        yearSet.add(y);
      }
    }
    for (const year of [...yearSet].sort((a, b) => b - a)) {
      const opt = document.createElement('option');
      opt.value = String(year);
      opt.textContent = String(year);
      yearSelect.appendChild(opt);
    }

    // Restore state from URL
    countrySelect.value = currentCountry;
    if (currentCountry) repopulateCitySelect(currentCountry);
    citySelect.value = currentCity;
    langSelect.value = currentLang;
    yearSelect.value = currentYear;
    sortSelect.value = currentSort;

    filterOptionsLoaded = true;
  }

  function repopulateCitySelect(iso3: string) {
    while (citySelect.options.length > 1) citySelect.remove(1);
    const cities = iso3 ? (cityMap.get(iso3) || []) : [];
    for (const city of cities) {
      const opt = document.createElement('option');
      opt.value = city;
      opt.textContent = city;
      citySelect.appendChild(opt);
    }
  }

  /* ── Document fetching ──────────────────────────────────────── */

  async function loadDocuments() {
    showLoading();
    if (currentSearch) {
      await loadHybridResults();
    } else {
      await loadGallery();
    }
  }

  async function loadGallery() {
    isHybridSearch = false;
    chunkInfoMap.clear();
    grid.classList.remove('search-mode');

    colCount = detectColCount();
    const from = (currentPage - 1) * getPerPage();
    const to   = from + getPerPage() - 1;

    let query = supabase
      .from('documents')
      .select('*', { count: 'exact' })
      .eq('doc_type', 'adaptation_plan');

    if (currentCountry) query = query.filter('metadata->>country_iso3', 'eq', currentCountry);
    if (currentCity)    query = query.filter('metadata->>city_name',    'eq', currentCity);
    if (currentLang)    query = query.filter('metadata->>language',     'eq', currentLang);
    if (currentYear)    query = query.filter('metadata->>year',         'eq', currentYear);

    if (currentSort === 'title-asc' || currentSort === 'title-desc') {
      query = query.order('title', { ascending: currentSort === 'title-asc' });
    } else if (currentSort === 'year-asc' || currentSort === 'year-desc') {
      query = query.order('metadata->>year', { ascending: currentSort === 'year-asc', nullsFirst: false });
    } else {
      query = query.order('created_at', { ascending: false });
    }
    query = query.range(from, to);

    const { data, error, count } = await query;
    if (error) { showError(); return; }

    totalCount = count || 0;
    const docs = (data || []) as Document[];
    if (currentSort === 'shuffle') {
      for (let i = docs.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [docs[i], docs[j]] = [docs[j], docs[i]];
      }
    }
    renderDocuments(docs);
    renderStatus();
    renderPagination();
  }

  async function loadHybridResults() {
    // 1. Embed the query via Edge Function
    let embedding: number[] | null = null;
    try {
      const { data, error } = await supabase.functions.invoke('embed-query', {
        body: { query: currentSearch },
      });
      if (!error && data?.embedding) embedding = data.embedding;
    } catch { /* fall through */ }

    if (!embedding) {
      await loadKeywordFallback();
      return;
    }

    // 2. Hybrid RRF search on chunks
    const { data: chunks, error: rpcErr } = await supabase.rpc('match_hybrid', {
      query_embedding: embedding,
      query_text: currentSearch,
      match_count: 80,
      filter_source: 'plan_crawler',
    }) as { data: SearchResult[] | null; error: unknown };

    if (rpcErr || !chunks?.length) {
      await loadKeywordFallback();
      return;
    }

    // 3. Dedupe by document_id, keep best (first) chunk per doc
    isHybridSearch = true;
    chunkInfoMap.clear();
    grid.classList.add('search-mode');

    for (const c of chunks) {
      if (!chunkInfoMap.has(c.document_id)) {
        chunkInfoMap.set(c.document_id, {
          content: c.content,
          page: c.page_number,
          vector_rank: c.vector_rank,
          keyword_rank: c.keyword_rank,
        });
      }
    }
    const topIds = [...chunkInfoMap.keys()].slice(0, 30);

    // 4. Fetch document rows, applying facet filters
    let docQuery = supabase
      .from('documents')
      .select('*')
      .in('id', topIds);

    if (currentCountry) docQuery = docQuery.filter('metadata->>country_iso3', 'eq', currentCountry);
    if (currentCity)    docQuery = docQuery.filter('metadata->>city_name',    'eq', currentCity);
    if (currentLang)    docQuery = docQuery.filter('metadata->>language',     'eq', currentLang);
    if (currentYear)    docQuery = docQuery.filter('metadata->>year',         'eq', currentYear);

    const { data: docs, error: docErr } = await docQuery;
    if (docErr) { showError(); return; }

    // 5. Re-sort by hybrid rank order (match_hybrid already ordered by score)
    const rankOrder = new Map(topIds.map((id, i) => [id, i]));
    const sorted = ((docs || []) as Document[]).sort(
      (a, b) => (rankOrder.get(a.id) ?? 999) - (rankOrder.get(b.id) ?? 999)
    );

    totalCount = sorted.length;
    renderDocuments(sorted);
    renderStatus();
    renderPagination();
  }

  async function loadKeywordFallback() {
    isHybridSearch = false;
    chunkInfoMap.clear();
    grid.classList.remove('search-mode');

    colCount = detectColCount();
    const from = (currentPage - 1) * getPerPage();
    const to   = from + getPerPage() - 1;

    let query = supabase
      .from('documents')
      .select('*', { count: 'exact' })
      .eq('doc_type', 'adaptation_plan');

    const escaped = currentSearch.replace(/[,()]/g, '');
    const pattern = `%${escaped}%`;
    query = query.or(
      [
        `title.ilike.${pattern}`,
        `metadata->>country_name.ilike.${pattern}`,
        `metadata->>country_iso3.ilike.${pattern}`,
        `metadata->>city_name.ilike.${pattern}`,
      ].join(',')
    );

    if (currentCountry) query = query.filter('metadata->>country_iso3', 'eq', currentCountry);
    if (currentCity)    query = query.filter('metadata->>city_name',    'eq', currentCity);
    if (currentLang)    query = query.filter('metadata->>language',     'eq', currentLang);
    if (currentYear)    query = query.filter('metadata->>year',         'eq', currentYear);

    query = query.order('created_at', { ascending: false }).range(from, to);

    const { data, error, count } = await query;
    if (error) { showError(); return; }

    totalCount = count || 0;
    renderDocuments((data || []) as Document[]);
    renderStatus();
    renderPagination();
  }

  /* ── Rendering ──────────────────────────────────────────────── */

  function showLoading() {
    statusEl.textContent = '';
    paginationEl.innerHTML = '';
    grid.innerHTML = `<div class="loading-state"><span class="spinner"></span> Loading…</div>`;
  }

  function showError() {
    grid.innerHTML = `<div class="state-message">Error loading documents — please refresh and try again.</div>`;
    statusEl.textContent = '';
    paginationEl.innerHTML = '';
  }

  function renderStatus() {
    if (totalCount === 0) {
      statusEl.textContent = '';
      return;
    }
    if (isHybridSearch) {
      statusEl.textContent = `${totalCount} result${totalCount === 1 ? '' : 's'} for "${currentSearch}"`;
      return;
    }
    const showing = Math.min(currentPage * getPerPage(), totalCount);
    const from    = (currentPage - 1) * getPerPage() + 1;
    statusEl.textContent = `${from}–${showing} of ${totalCount.toLocaleString()} plans`;
  }

  function renderDocuments(docs: Document[]) {
    if (docs.length === 0) {
      const hasFilter = currentSearch || currentCountry || currentCity || currentLang;
      grid.innerHTML = `
        <div class="state-message">
          <p>No plans found${currentSearch ? ` matching <strong>"${escapeHtml(currentSearch)}"</strong>` : ''}.</p>
          ${hasFilter ? '<p style="margin-top:0.5em;font-size:0.875rem">Try adjusting your search or filters.</p>' : ''}
        </div>
      `;
      return;
    }

    grid.innerHTML = docs.map(doc => cardHtml(doc)).join('');
  }

  const LANG_LABELS: Record<string, string> = {
    'ar': 'Arabic', 'ca': 'Catalan', 'cy': 'Welsh', 'de': 'German',
    'el': 'Greek', 'en': 'English', 'es': 'Spanish', 'fi': 'Finnish',
    'fr': 'French', 'he': 'Hebrew', 'id': 'Indonesian', 'ja': 'Japanese',
    'ko': 'Korean', 'nl': 'Dutch', 'no': 'Norwegian', 'pl': 'Polish',
    'pt': 'Portuguese', 'ro': 'Romanian', 'ru': 'Russian', 'tl': 'Filipino',
    'tr': 'Turkish', 'uk': 'Ukrainian', 'zh-cn': 'Chinese',
  };

  function cardHtml(doc: Document): string {
    const pdfUrl  = doc.storage_path
      ? getPublicUrl('plans', doc.storage_path.replace('plans/', ''))
      : '#';
    const thumbUrl = doc.thumbnail_path
      ? getPublicUrl('thumbnails', doc.thumbnail_path.replace('thumbnails/', ''))
      : '';
    const location = [doc.metadata?.city_name, doc.metadata?.country_name].filter(Boolean).join(', ');
    const langCode = doc.metadata?.language as string | undefined;
    const language = langCode ? (LANG_LABELS[langCode] ?? langCode.toUpperCase()) : undefined;
    const year     = doc.metadata?.year as number | undefined;

    const thumb = thumbUrl
      ? `<img src="${thumbUrl}" alt="" loading="lazy" class="doc-thumb"/>`
      : `<div class="doc-thumb-placeholder">
           <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
             <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
           </svg>
         </div>`;

    const metaParts = [
      year     ? `<span class="doc-meta-item">${year}</span>` : '',
      language ? `<span class="doc-meta-item doc-meta-lang">${escapeHtml(language)}</span>` : '',
    ].filter(Boolean).join('<span class="doc-meta-sep">·</span>');


    return `
      <article class="doc-card">
        <a href="${pdfUrl}" target="_blank" rel="noopener noreferrer" class="doc-thumb-wrap">${thumb}</a>
        <div class="doc-body">
          <h3 class="doc-title">
            <a href="${pdfUrl}" target="_blank" rel="noopener noreferrer">
              ${currentSearch ? highlightText(doc.title, currentSearch) : escapeHtml(doc.title)}
            </a>
          </h3>
          ${location ? `<div class="doc-location">${escapeHtml(location)}</div>` : ''}
          ${metaParts ? `<div class="doc-meta">${metaParts}</div>` : ''}
        </div>
        <button class="doc-report-btn" onclick="window.openFeedbackModal('${doc.id}')" title="Report a problem with this plan" aria-label="Report a problem">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </button>
      </article>
    `;
  }


  function renderPagination() {
    if (totalCount <= getPerPage()) {
      paginationEl.innerHTML = '';
      return;
    }

    const totalPages = Math.ceil(totalCount / getPerPage());

    paginationEl.innerHTML = `
      <div class="pagination-inner">
        <button class="btn btn-secondary page-btn" data-page="${currentPage - 1}" ${currentPage <= 1 ? 'disabled' : ''}>← Prev</button>
        <span class="page-info">Page ${currentPage} of ${totalPages}</span>
        <button class="btn btn-secondary page-btn" data-page="${currentPage + 1}" ${currentPage >= totalPages ? 'disabled' : ''}>Next →</button>
      </div>
    `;

    paginationEl.querySelectorAll<HTMLButtonElement>('.page-btn:not([disabled])').forEach(btn => {
      btn.addEventListener('click', () => {
        currentPage = parseInt(btn.dataset.page!);
        pushUrl();
        loadDocuments();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });
  }

  /* ── Utilities ──────────────────────────────────────────────── */

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function highlightText(text: string, query: string): string {
    const words = query.toLowerCase().split(/\s+/).filter(w => w.length > 1);
    let out = escapeHtml(text);
    words.forEach(word => {
      const re = new RegExp(`(${word.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
      out = out.replace(re, '<mark style="background:rgba(179,27,27,0.12);color:var(--carnelian-deep);border-radius:2px;padding:0 0.15em">$1</mark>');
    });
    return out;
  }

  /* ── Event wiring ───────────────────────────────────────────── */

  searchInput.addEventListener('keydown', async (e) => {
    if (e.key !== 'Enter') return;
    currentSearch = searchInput.value.trim();
    currentPage = 1;
    pushUrl();
    syncClearAll();
    await loadDocuments();
  });

  searchInput.addEventListener('input', () => {
    syncClearButton();
    if (searchInput.value === '' && currentSearch !== '') {
      currentSearch = '';
      currentPage = 1;
      pushUrl();
      syncClearAll();
      loadDocuments();
    }
  });

  searchClear.addEventListener('click', () => {
    searchInput.value = '';
    syncClearButton();
    if (currentSearch !== '') {
      currentSearch = '';
      currentPage = 1;
      pushUrl();
      syncClearAll();
      loadDocuments();
    }
    searchInput.focus();
  });

  countrySelect.addEventListener('change', async () => {
    currentCountry = countrySelect.value;
    currentCity = '';
    currentPage = 1;
    repopulateCitySelect(currentCountry);
    citySelect.value = '';
    pushUrl();
    syncClearAll();
    await loadDocuments();
  });

  citySelect.addEventListener('change', async () => {
    currentCity = citySelect.value;
    currentPage = 1;
    pushUrl();
    syncClearAll();
    await loadDocuments();
  });

  langSelect.addEventListener('change', async () => {
    currentLang = langSelect.value;
    currentPage = 1;
    pushUrl();
    syncClearAll();
    await loadDocuments();
  });

  yearSelect.addEventListener('change', async () => {
    currentYear = yearSelect.value;
    currentPage = 1;
    pushUrl();
    syncClearAll();
    await loadDocuments();
  });

  sortSelect.addEventListener('change', async () => {
    currentSort = sortSelect.value;
    currentPage = 1;
    pushUrl();
    await loadDocuments();
  });

  clearAllBtn.addEventListener('click', () => {
    searchInput.value = '';
    countrySelect.value = '';
    citySelect.value = '';
    langSelect.value = '';
    yearSelect.value = '';
    repopulateCitySelect('');
    currentSearch = currentCountry = currentCity = currentLang = currentYear = '';
    currentPage = 1;
    pushUrl();
    syncClearButton();
    syncClearAll();
    loadDocuments();
    searchInput.focus();
  });

  // Handle browser back/forward
  window.addEventListener('popstate', () => {
    readUrl();
    searchInput.value = currentSearch;
    syncClearButton();
    syncClearAll();
    countrySelect.value = currentCountry;
    if (filterOptionsLoaded) {
      repopulateCitySelect(currentCountry);
      citySelect.value = currentCity;
      yearSelect.value = currentYear;
    }
    langSelect.value = currentLang;
    sortSelect.value = currentSort;
    loadDocuments();
  });

  /* ── Init ────────────────────────────────────────────────────── */

  readUrl();
  searchInput.value = currentSearch;
  sortSelect.value = currentSort;
  syncClearButton();
  syncClearAll();

  // Reset to page 1 and reload when the grid column count changes (e.g. window resize).
  let resizeTimer: ReturnType<typeof setTimeout> | null = null;
  new ResizeObserver(() => {
    if (resizeTimer) clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      const newCols = detectColCount();
      if (newCols !== colCount) {
        currentPage = 1;
        loadDocuments();
      }
    }, 200);
  }).observe(grid);

  // Fire all three in parallel
  loadDocuments();
  loadFilterOptions();
  loadStats();
</script>
