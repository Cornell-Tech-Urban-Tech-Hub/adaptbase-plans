---
// Search functionality has moved to the home page.
// Redirect preserving any ?q= query parameter.
---
<script>
  const q = new URLSearchParams(window.location.search).get('q');
  window.location.replace(q ? `/?q=${encodeURIComponent(q)}` : '/');
</script>
<noscript>
  <meta http-equiv="refresh" content="0;url=/" />
</noscript>
