---
---

<div id="submit-plan-modal" class="modal" aria-hidden="true" aria-modal="true" role="dialog" aria-labelledby="submit-plan-modal-title">
  <div class="modal-overlay"></div>
  <div class="modal-content">
    <button class="modal-close" aria-label="Close">&times;</button>
    <div class="modal-header">
      <svg class="header-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
      <div>
        <h2 id="submit-plan-modal-title">Submit a plan</h2>
        <p class="modal-desc">Help us expand our collection by submitting a climate adaptation or resilience plan.</p>
      </div>
    </div>

    <form id="submit-plan-form">
      <p class="field-hint"><span class="required-star">*</span> = required field</p>

      <div class="field-group">
        <label class="field-label" for="sp-city">
          City <span class="required-star">*</span>
        </label>
        <input type="text" id="sp-city" required placeholder="e.g. Cape Town" />
      </div>

      <div class="field-group">
        <label class="field-label" for="sp-url">
          Plan URL <span class="required-star">*</span>
        </label>
        <input type="url" id="sp-url" required placeholder="https://..." />
        <p class="field-help">Direct link to the PDF or webpage where the plan can be accessed</p>
      </div>

      <div class="field-divider"></div>

      <p class="section-label">Your contact information</p>

      <div class="field-group">
        <label class="field-label" for="sp-submitter-name">
          Name <span class="required-star">*</span>
        </label>
        <input type="text" id="sp-submitter-name" required placeholder="Your name" />
      </div>

      <div class="field-group">
        <label class="field-label" for="sp-submitter-email">
          Email <span class="required-star">*</span>
        </label>
        <input type="email" id="sp-submitter-email" required placeholder="your.email@example.com" />
      </div>

      <div class="field-divider"></div>

      <p class="section-label">Additional information (optional)</p>

      <div class="field-group">
        <label class="field-label" for="sp-title">Plan title</label>
        <input type="text" id="sp-title" placeholder="e.g. Cape Town Climate Action Plan 2040" />
      </div>

      <div class="meta-grid">
        <div class="field-group">
          <label class="field-label" for="sp-country">Country</label>
          <input type="text" id="sp-country" placeholder="e.g. South Africa" />
        </div>
        <div class="field-group">
          <label class="field-label" for="sp-year">Year</label>
          <input type="text" id="sp-year" placeholder="e.g. 2023" inputmode="numeric" />
        </div>
      </div>

      <div class="field-group">
        <label class="field-label" for="sp-language">Language</label>
        <input type="text" id="sp-language" placeholder="e.g. English, EN" />
      </div>

      <div class="field-group">
        <label class="field-label" for="sp-notes">Additional notes</label>
        <textarea id="sp-notes" rows="3" placeholder="Any context that might help us review this submission…"></textarea>
      </div>

      <div class="submit-actions">
        <button type="button" class="btn btn-secondary" id="submit-cancel">Cancel</button>
        <button type="submit" class="btn btn-primary" id="submit-submit">Submit plan</button>
      </div>
    </form>

    <div id="submit-success" class="submit-success" hidden>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      Thank you! Your submission has been received and will be reviewed shortly.
    </div>
  </div>
</div>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabaseUrl  = import.meta.env.PUBLIC_SUPABASE_URL as string;
  const supabaseKey  = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string;
  const supabase     = createClient(supabaseUrl, supabaseKey);

  const modal          = document.getElementById('submit-plan-modal')!;
  const overlay        = modal.querySelector('.modal-overlay')!;
  const closeBtn       = modal.querySelector('.modal-close')!;
  const cancelBtn      = document.getElementById('submit-cancel')!;
  const form           = document.getElementById('submit-plan-form') as HTMLFormElement;
  const submitBtn      = document.getElementById('submit-submit')!;
  const successEl      = document.getElementById('submit-success')!;

  function openModal() {
    successEl.hidden = true;
    form.hidden = false;
    form.reset();
    modal.classList.add('active');
    modal.setAttribute('aria-hidden', 'false');
    setTimeout(() => {
      (document.getElementById('sp-city') as HTMLInputElement).focus();
    }, 100);
  }

  function closeModal() {
    modal.classList.remove('active');
    modal.setAttribute('aria-hidden', 'true');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const city           = (document.getElementById('sp-city') as HTMLInputElement).value.trim();
    const url            = (document.getElementById('sp-url') as HTMLInputElement).value.trim();
    const submitterName  = (document.getElementById('sp-submitter-name') as HTMLInputElement).value.trim();
    const submitterEmail = (document.getElementById('sp-submitter-email') as HTMLInputElement).value.trim();
    const title          = (document.getElementById('sp-title') as HTMLInputElement).value.trim() || null;
    const country        = (document.getElementById('sp-country') as HTMLInputElement).value.trim() || null;
    const yearStr        = (document.getElementById('sp-year') as HTMLInputElement).value.trim();
    const year           = yearStr ? parseInt(yearStr, 10) : null;
    const language       = (document.getElementById('sp-language') as HTMLInputElement).value.trim() || null;
    const notes          = (document.getElementById('sp-notes') as HTMLTextAreaElement).value.trim() || null;

    submitBtn.setAttribute('disabled', 'true');
    submitBtn.textContent = 'Submitting…';

    const { error } = await supabase.from('plan_submissions').insert({
      city,
      url,
      submitter_name: submitterName,
      submitter_email: submitterEmail,
      title,
      country,
      year,
      language,
      notes,
    });

    submitBtn.removeAttribute('disabled');
    submitBtn.textContent = 'Submit plan';

    if (error) {
      console.error('Submission error:', error);
      alert('Something went wrong — please try again.');
      return;
    }

    form.hidden = true;
    successEl.hidden = false;
    setTimeout(closeModal, 3000);
  });

  closeBtn.addEventListener('click', closeModal);
  cancelBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', closeModal);
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && modal.classList.contains('active')) closeModal();
  });

  (window as any).openSubmitPlanModal = openModal;
</script>

<style>
  .modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .modal.active {
    display: flex;
  }

  .modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
  }

  .modal-content {
    position: relative;
    background: var(--bg-1);
    border-radius: var(--r-lg);
    padding: var(--sp-6);
    width: min(540px, calc(100vw - var(--sp-6)));
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: var(--shadow-3);
  }

  .modal-close {
    position: absolute;
    top: var(--sp-4);
    right: var(--sp-4);
    background: transparent;
    border: none;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--fg-4);
    cursor: pointer;
    padding: 4px;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-md);
    transition: background var(--dur-fast) var(--ease-standard),
                color var(--dur-fast) var(--ease-standard);
  }

  .modal-close:hover {
    background: var(--bg-3);
    color: var(--fg-1);
  }

  .modal-header {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    margin-bottom: var(--sp-5);
    padding-right: var(--sp-7);
  }

  .header-icon {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--fg-3);
  }

  h2 {
    font-size: 1.125rem;
    margin-bottom: var(--sp-1);
  }

  .modal-desc {
    font-size: 0.8125rem;
    color: var(--fg-4);
    margin: 0;
  }

  .field-hint {
    font-size: 0.8125rem;
    color: var(--fg-4);
    margin-bottom: var(--sp-4);
  }

  .required-star {
    color: var(--carnelian);
  }

  .section-label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fg-3);
    margin-bottom: var(--sp-3);
  }

  .field-group {
    margin-bottom: var(--sp-4);
  }

  .field-label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--fg-2);
    margin-bottom: var(--sp-2);
  }

  .field-help {
    font-size: 0.75rem;
    color: var(--fg-4);
    margin-top: var(--sp-1);
    line-height: 1.4;
  }

  .field-divider {
    height: 1px;
    background: var(--border-hair);
    margin: var(--sp-5) 0;
  }

  input[type="text"],
  input[type="url"],
  input[type="email"] {
    width: 100%;
    padding: var(--sp-2) var(--sp-3);
  }

  textarea {
    width: 100%;
    padding: var(--sp-3);
    resize: vertical;
    min-height: 80px;
    border-radius: var(--r-md);
  }

  .meta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
  }

  .submit-actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--sp-3);
    margin-top: var(--sp-5);
  }

  .submit-success {
    display: none;
    align-items: center;
  }

  .submit-success:not([hidden]) {
    display: flex;
    gap: var(--sp-2);
    color: var(--chlorophyll);
    font-size: 0.9375rem;
    font-weight: 500;
    padding: var(--sp-4);
    background: var(--chlorophyll-soft);
    border-radius: var(--r-md);
    margin-top: var(--sp-4);
  }

  .submit-success svg {
    flex-shrink: 0;
    stroke: var(--chlorophyll);
  }

  @media (max-width: 600px) {
    .meta-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
