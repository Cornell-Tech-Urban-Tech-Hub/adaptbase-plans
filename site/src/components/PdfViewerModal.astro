---
---

<div id="pdf-viewer-modal" class="modal" aria-hidden="true" aria-modal="true" role="dialog" aria-label="PDF Viewer">
  <div class="modal-overlay"></div>
  <div class="pdf-viewer-content">
    <div class="pdf-toolbar">
      <div class="pdf-toolbar-left">
        <span class="pdf-title" id="pdf-viewer-title"></span>
      </div>
      <div class="pdf-toolbar-center">
        <button class="pdf-nav-btn" id="pdf-prev" aria-label="Previous page">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <span class="pdf-page-info" id="pdf-page-info">Page 1 of 1</span>
        <button class="pdf-nav-btn" id="pdf-next" aria-label="Next page">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
      <div class="pdf-toolbar-right">
        <div class="pdf-goto">
          <label for="pdf-goto-input" class="pdf-goto-label">p.</label>
          <input type="number" id="pdf-goto-input" class="pdf-goto-input" min="1" placeholder="—" aria-label="Go to page" />
        </div>
        <a class="pdf-download-btn" id="pdf-download-link" href="#" target="_blank" rel="noopener noreferrer" aria-label="Download PDF">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        </a>
        <button class="pdf-report-btn" id="pdf-report" aria-label="Report a problem" title="Report a problem" hidden>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12 6.75a5.25 5.25 0 0 1 6.775-5.025.75.75 0 0 1 .313 1.248l-3.32 3.319c.063.475.276.903.641 1.193.363.287.849.394 1.408.237l3.32-3.32a.75.75 0 0 1 1.248.313 5.25 5.25 0 0 1-5.472 6.756c-1.018-.086-1.87.1-2.309.634L7.344 21.3A3.298 3.298 0 1 1 2.7 16.657l8.684-7.151c.533-.44.72-1.291.634-2.309z" clip-rule="evenodd"/></svg>
        </button>
        <button class="pdf-close-btn" id="pdf-close" aria-label="Close viewer">&times;</button>
      </div>
    </div>
    <div class="pdf-viewport" id="pdf-viewport">
      <div class="pdf-loading" id="pdf-loading">
        <span class="spinner"></span> Loading PDF…
      </div>
      <div class="pdf-error" id="pdf-error" hidden>
        <p>Failed to load PDF.</p>
        <a id="pdf-error-link" href="#" target="_blank" rel="noopener noreferrer">Open in new tab</a>
      </div>
      <div class="pdf-page-container" id="pdf-page-container">
        <canvas id="pdf-canvas"></canvas>
        <div class="pdf-text-layer" id="pdf-text-layer"></div>
      </div>
    </div>
  </div>
</div>

<script>
  import { getDocument, GlobalWorkerOptions, TextLayer } from 'pdfjs-dist';

  const PDFJS_VERSION = '5.7.284';
  GlobalWorkerOptions.workerSrc = `https://cdn.jsdelivr.net/npm/pdfjs-dist@${PDFJS_VERSION}/build/pdf.worker.min.mjs`;

  const modal = document.getElementById('pdf-viewer-modal')!;
  const overlay = modal.querySelector('.modal-overlay')!;
  const closeBtn = document.getElementById('pdf-close')!;
  const prevBtn = document.getElementById('pdf-prev')!;
  const nextBtn = document.getElementById('pdf-next')!;
  const titleEl = document.getElementById('pdf-viewer-title')!;
  const pageInfoEl = document.getElementById('pdf-page-info')!;
  const viewport = document.getElementById('pdf-viewport')!;
  const loadingEl = document.getElementById('pdf-loading')!;
  const errorEl = document.getElementById('pdf-error')!;
  const errorLink = document.getElementById('pdf-error-link')! as HTMLAnchorElement;
  const downloadLink = document.getElementById('pdf-download-link')! as HTMLAnchorElement;
  const pageContainer = document.getElementById('pdf-page-container')!;
  const canvas = document.getElementById('pdf-canvas')! as HTMLCanvasElement;
  const textLayerEl = document.getElementById('pdf-text-layer')!;
  const gotoInput = document.getElementById('pdf-goto-input')! as HTMLInputElement;
  const reportBtn = document.getElementById('pdf-report')! as HTMLButtonElement;

  let pdfDoc: any = null;
  let currentPageNum = 1;
  let totalPages = 0;
  let highlightTerms: string[] = [];
  let rendering = false;
  let currentDocId: string | null = null;

  async function openPdfViewer(pdfUrl: string, pageNumber: number, terms: string[], title?: string, docId?: string | null) {
    modal.classList.add('active');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    currentDocId = docId || null;
    titleEl.textContent = title || 'Document';
    downloadLink.href = pdfUrl;
    errorLink.href = pdfUrl;
    reportBtn.hidden = !currentDocId;
    highlightTerms = terms.map(t => t.toLowerCase());
    currentPageNum = Math.max(1, pageNumber || 1);

    loadingEl.hidden = false;
    errorEl.hidden = true;
    pageContainer.hidden = true;

    try {
      const loadingTask = getDocument({ url: pdfUrl, cMapUrl: `https://cdn.jsdelivr.net/npm/pdfjs-dist@${PDFJS_VERSION}/cmaps/`, cMapPacked: true });
      pdfDoc = await loadingTask.promise;
      totalPages = pdfDoc.numPages;
      currentPageNum = Math.min(currentPageNum, totalPages);
      await renderPage(currentPageNum);
    } catch (err) {
      loadingEl.hidden = true;
      errorEl.hidden = false;
    }
  }

  async function renderPage(num: number) {
    if (rendering) return;
    rendering = true;

    loadingEl.hidden = false;
    pageContainer.hidden = true;

    try {
      const page = await pdfDoc.getPage(num);
      const scale = calculateScale(page);
      const vp = page.getViewport({ scale });

      canvas.width = vp.width;
      canvas.height = vp.height;
      canvas.style.width = `${vp.width}px`;
      canvas.style.height = `${vp.height}px`;

      const ctx = canvas.getContext('2d')!;
      await page.render({ canvasContext: ctx, viewport: vp }).promise;

      // Show page as soon as canvas is ready — don't wait for text layer
      loadingEl.hidden = true;
      pageContainer.hidden = false;
      updatePageInfo();

      // Text layer builds after page is visible
      textLayerEl.innerHTML = '';
      textLayerEl.style.width = `${vp.width}px`;
      textLayerEl.style.height = `${vp.height}px`;

      const textContent = await page.getTextContent();
      const textLayer = new TextLayer({
        textContentSource: textContent,
        container: textLayerEl,
        viewport: vp,
      });
      await textLayer.render();

      if (highlightTerms.length > 0) {
        highlightTextLayer();
      }
    } catch {
      loadingEl.hidden = true;
      errorEl.hidden = false;
    } finally {
      rendering = false;
    }
  }

  function calculateScale(page: any): number {
    const unscaledVp = page.getViewport({ scale: 1 });
    const maxWidth = viewport.clientWidth - 48;
    const maxHeight = viewport.clientHeight - 24;
    const scaleW = maxWidth / unscaledVp.width;
    const scaleH = maxHeight / unscaledVp.height;
    return Math.min(scaleW, scaleH, 2.5);
  }

  function highlightTextLayer() {
    const spans = textLayerEl.querySelectorAll('span');
    spans.forEach(span => {
      const text = span.textContent || '';
      const lower = text.toLowerCase();
      let hasMatch = false;
      for (const term of highlightTerms) {
        if (term.length > 1 && lower.includes(term)) {
          hasMatch = true;
          break;
        }
      }
      if (hasMatch) {
        span.classList.add('pdf-highlight');
      }
    });
  }

  function updatePageInfo() {
    pageInfoEl.textContent = `Page ${currentPageNum} of ${totalPages}`;
    gotoInput.max = String(totalPages);
    gotoInput.value = String(currentPageNum);
    (prevBtn as HTMLButtonElement).disabled = currentPageNum <= 1;
    (nextBtn as HTMLButtonElement).disabled = currentPageNum >= totalPages;
  }

  function closeModal() {
    modal.classList.remove('active');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    pdfDoc = null;
    canvas.width = 0;
    canvas.height = 0;
    textLayerEl.innerHTML = '';
  }

  prevBtn.addEventListener('click', () => {
    if (currentPageNum > 1) {
      currentPageNum--;
      renderPage(currentPageNum);
    }
  });

  nextBtn.addEventListener('click', () => {
    if (currentPageNum < totalPages) {
      currentPageNum++;
      renderPage(currentPageNum);
    }
  });

  gotoInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const n = parseInt(gotoInput.value);
      if (n >= 1 && n <= totalPages && n !== currentPageNum) {
        currentPageNum = n;
        renderPage(currentPageNum);
      }
      gotoInput.blur();
    }
    if (e.key === 'Escape') {
      gotoInput.value = String(currentPageNum);
      gotoInput.blur();
    }
  });

  reportBtn.addEventListener('click', () => {
    if (currentDocId && (window as any).openFeedbackModal) {
      closeModal();
      (window as any).openFeedbackModal(currentDocId);
    }
  });

  closeBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => {
    if (!modal.classList.contains('active')) return;
    if (e.key === 'Escape') closeModal();
    if (e.key === 'ArrowLeft' && currentPageNum > 1) { currentPageNum--; renderPage(currentPageNum); }
    if (e.key === 'ArrowRight' && currentPageNum < totalPages) { currentPageNum++; renderPage(currentPageNum); }
  });

  (window as any).openPdfViewer = openPdfViewer;
</script>

<style>
  #pdf-viewer-modal .pdf-viewer-content {
    position: fixed;
    inset: 0;
    z-index: 1001;
    display: flex;
    flex-direction: column;
    background: var(--ink);
  }

  .pdf-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--sp-3) var(--sp-4);
    background: var(--ink-2);
    border-bottom: 1px solid rgba(255,255,255,0.08);
    flex-shrink: 0;
    gap: var(--sp-3);
  }

  .pdf-toolbar-left,
  .pdf-toolbar-center,
  .pdf-toolbar-right {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .pdf-toolbar-left { flex: 1; min-width: 0; }
  .pdf-toolbar-center { flex-shrink: 0; }
  .pdf-toolbar-right { flex: 1; justify-content: flex-end; gap: var(--sp-3); }

  .pdf-goto {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .pdf-goto-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: rgba(255,255,255,0.45);
    white-space: nowrap;
  }

  .pdf-goto-input {
    width: 48px;
    padding: 4px 6px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: var(--r-sm);
    color: var(--white);
    text-align: center;
    -moz-appearance: textfield;
    transition: border-color var(--dur-fast) var(--ease-standard),
                background var(--dur-fast) var(--ease-standard);
  }

  .pdf-goto-input::-webkit-outer-spin-button,
  .pdf-goto-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
  }

  .pdf-goto-input:focus {
    outline: none;
    background: rgba(255,255,255,0.12);
    border-color: rgba(255,255,255,0.3);
  }

  .pdf-title {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--white);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pdf-page-info {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgba(255,255,255,0.7);
    white-space: nowrap;
  }

  .pdf-nav-btn {
    background: rgba(255,255,255,0.08);
    border: none;
    border-radius: var(--r-md);
    padding: 6px 8px;
    color: rgba(255,255,255,0.8);
    cursor: pointer;
    display: flex;
    align-items: center;
    transition: background var(--dur-fast) var(--ease-standard);
  }

  .pdf-nav-btn:hover:not(:disabled) {
    background: rgba(255,255,255,0.16);
    color: var(--white);
  }

  .pdf-nav-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .pdf-download-btn {
    background: rgba(255,255,255,0.08);
    border: none;
    border-radius: var(--r-md);
    padding: 6px 8px;
    color: rgba(255,255,255,0.8);
    cursor: pointer;
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-standard);
  }

  .pdf-download-btn:hover {
    background: rgba(255,255,255,0.16);
    color: var(--white);
    text-decoration: none;
  }

  .pdf-report-btn {
    background: rgba(255,255,255,0.08);
    border: none;
    border-radius: var(--r-md);
    padding: 6px 8px;
    color: rgba(255,255,255,0.6);
    cursor: pointer;
    display: flex;
    align-items: center;
    transition: background var(--dur-fast) var(--ease-standard),
                color var(--dur-fast) var(--ease-standard);
  }

  .pdf-report-btn:hover {
    background: rgba(255,255,255,0.16);
    color: rgba(255,255,255,0.9);
  }

  .pdf-report-btn[hidden] {
    display: none;
  }

  .pdf-close-btn {
    background: rgba(255,255,255,0.08);
    border: none;
    border-radius: var(--r-md);
    padding: 4px 10px;
    font-size: 1.5rem;
    line-height: 1;
    color: rgba(255,255,255,0.8);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-standard);
  }

  .pdf-close-btn:hover {
    background: rgba(255,255,255,0.16);
    color: var(--white);
  }

  .pdf-viewport {
    flex: 1;
    overflow: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-4);
  }

  /* Author-side display: flex overrides UA [hidden] display: none — fix it explicitly */
  .pdf-loading[hidden],
  .pdf-error[hidden],
  .pdf-page-container[hidden] {
    display: none !important;
  }

  .pdf-loading {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    color: rgba(255,255,255,0.7);
    font-size: 0.9375rem;
  }

  .pdf-loading .spinner {
    border-color: rgba(255,255,255,0.2);
    border-top-color: var(--white);
  }

  .pdf-error {
    text-align: center;
    color: rgba(255,255,255,0.7);
    font-size: 0.9375rem;
  }

  .pdf-error a {
    color: rgba(255,255,255,0.9);
    text-decoration: underline;
    margin-top: var(--sp-3);
    display: inline-block;
  }

  .pdf-page-container {
    position: relative;
    box-shadow: 0 4px 24px rgba(0,0,0,0.4);
    line-height: 0;
  }

  #pdf-canvas {
    display: block;
  }

  .pdf-text-layer {
    position: absolute;
    top: 0;
    left: 0;
    overflow: hidden;
    opacity: 0.3;
    line-height: 1;
  }

  .pdf-text-layer :global(span) {
    position: absolute;
    white-space: pre;
    color: transparent;
    pointer-events: all;
    cursor: text;
  }

  .pdf-text-layer :global(span.pdf-highlight) {
    background: rgba(179, 27, 27, 0.35);
    border-radius: 2px;
  }

  #pdf-viewer-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
  }

  #pdf-viewer-modal.active {
    display: block;
  }

  #pdf-viewer-modal > .modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
  }
</style>
