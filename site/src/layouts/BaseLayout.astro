---
import AboutModal from '../components/AboutModal.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Searchable archive of urban climate adaptation and resilience plans' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Adaptbase Plans</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Instrument+Serif:ital@0;1&family=Inter+Tight:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand-link">
        <span class="brand-eyebrow">Adaptbase</span>
        <span class="brand-divider" aria-hidden="true"></span>
        <span class="brand-name">Plans</span>
      </a>
      <div class="header-actions">
        <button class="btn-ghost" id="about-button">About</button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          Part of <a href="https://adaptbase.us">Adaptbase</a> ·
          Powered by <a href="https://supabase.com">Supabase</a> &amp; <a href="https://astro.build">Astro</a>
        </p>
      </div>
    </footer>

    <AboutModal />

    <script>
      const aboutButton = document.getElementById('about-button');
      const modal = document.getElementById('about-modal');
      const modalClose = modal?.querySelector('.modal-close');
      const modalOverlay = modal?.querySelector('.modal-overlay');

      aboutButton?.addEventListener('click', () => {
        modal?.classList.add('active');
        modal?.setAttribute('aria-hidden', 'false');
      });

      const closeModal = () => {
        modal?.classList.remove('active');
        modal?.setAttribute('aria-hidden', 'true');
      };

      modalClose?.addEventListener('click', closeModal);
      modalOverlay?.addEventListener('click', closeModal);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal?.classList.contains('active')) {
          closeModal();
        }
      });
    </script>
  </body>
</html>

<style is:global>
  /* ============================================================
     DESIGN TOKENS
     ============================================================ */
  :root {
    /* Fonts */
    --font-display: 'Fraunces', Georgia, serif;
    --font-sans:    'Inter Tight', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-mono:    'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    --font-accent:  'Instrument Serif', Georgia, serif;

    /* Brand */
    --carnelian:        #B31B1B;
    --carnelian-deep:   #8C1515;
    --carnelian-bright: #E4002B;

    /* Neutrals (ink → paper) */
    --ink:      #121417;
    --ink-2:    #2A2D33;
    --graphite: #4A4F57;
    --concrete: #8A8F98;
    --mist:     #C7CAD1;
    --stone:    #E3E5E9;
    --fog:      #EFF0F3;
    --paper:    #F7F6F2;
    --paper-2:  #FBFAF6;
    --white:    #FFFFFF;

    /* Accents */
    --blueprint:        #1E4DD8;
    --blueprint-soft:   #D9E1F7;
    --sodium:           #F4A02C;
    --sodium-soft:      #FBE8C6;
    --chlorophyll:      #2E7D4F;
    --chlorophyll-soft: #D4E4D8;

    /* Semantic foreground/background */
    --fg-1:     var(--ink);
    --fg-2:     var(--ink-2);
    --fg-3:     var(--graphite);
    --fg-4:     var(--concrete);
    --fg-brand: var(--carnelian);
    --fg-link:  var(--carnelian-deep);
    --bg-1:     var(--paper);
    --bg-2:     var(--paper-2);
    --bg-3:     var(--fog);
    --bg-4:     var(--stone);
    --bg-brand: var(--carnelian);

    /* Status */
    --status-success: var(--chlorophyll);

    /* Borders */
    --border-hair: rgba(18, 20, 23, 0.08);
    --border-soft: rgba(18, 20, 23, 0.14);
    --border-firm: rgba(18, 20, 23, 0.24);

    /* Shadows */
    --shadow-1: 0 1px 0 rgba(18,20,23,0.04), 0 1px 2px rgba(18,20,23,0.04);
    --shadow-2: 0 1px 0 rgba(18,20,23,0.04), 0 6px 16px -6px rgba(18,20,23,0.10);
    --shadow-3: 0 2px 0 rgba(18,20,23,0.04), 0 18px 40px -12px rgba(18,20,23,0.18);

    /* Spacing (4px base) */
    --sp-1:  0.25rem;
    --sp-2:  0.5rem;
    --sp-3:  0.75rem;
    --sp-4:  1rem;
    --sp-5:  1.5rem;
    --sp-6:  2rem;
    --sp-7:  3rem;
    --sp-8:  4rem;
    --sp-9:  6rem;
    --sp-10: 8rem;

    /* Radii */
    --r-sm:   2px;
    --r-md:   4px;
    --r-lg:   8px;
    --r-xl:   14px;
    --r-pill: 999px;

    /* Motion */
    --ease-standard: cubic-bezier(0.4, 0, 0.2, 1);
    --ease-out:      cubic-bezier(0.16, 1, 0.3, 1);
    --dur-fast: 120ms;
    --dur-base: 220ms;

    /* Backwards-compat aliases used in existing component CSS */
    --brand:       var(--carnelian);
    --brand-dark:  var(--carnelian-deep);
    --brand-light: var(--sodium-soft);
    --gray-50:     var(--paper);
    --gray-100:    var(--fog);
    --gray-200:    var(--stone);
    --gray-300:    var(--mist);
    --gray-600:    var(--concrete);
    --gray-700:    var(--graphite);
    --gray-800:    var(--ink-2);
    --gray-900:    var(--ink);
    --success:     var(--chlorophyll);
    --space-2:     var(--sp-2);
    --space-3:     var(--sp-3);
    --space-4:     var(--sp-4);
    --space-6:     var(--sp-5);
    --space-8:     var(--sp-6);
    --space-12:    var(--sp-7);
    --radius-sm:   var(--r-sm);
    --radius-md:   var(--r-md);
    --shadow-sm:   var(--shadow-1);
    --shadow-md:   var(--shadow-2);
    --font-ui:     var(--font-sans);
  }

  /* ============================================================
     RESET & BASE
     ============================================================ */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.5;
    color: var(--fg-1);
    background: var(--bg-1);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* ============================================================
     TYPOGRAPHY
     ============================================================ */
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.15;
    color: var(--fg-1);
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-variation-settings: "opsz" 72;
    letter-spacing: -0.025em;
  }

  h2 {
    font-size: clamp(1.375rem, 3vw, 2rem);
    font-variation-settings: "opsz" 48;
    letter-spacing: -0.015em;
  }

  h3 {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 1.4;
  }

  p {
    color: var(--fg-2);
    line-height: 1.6;
  }

  a {
    color: var(--fg-link);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-standard);
  }

  a:hover {
    color: var(--carnelian-bright);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  /* ============================================================
     LAYOUT
     ============================================================ */
  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--sp-5);
  }

  .container-wide {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 var(--sp-5);
  }

  main {
    flex: 1;
  }

  /* ============================================================
     SITE HEADER
     ============================================================ */
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--sp-3) var(--sp-5);
    background: var(--bg-1);
    border-bottom: 1px solid var(--border-hair);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    text-decoration: none;
  }

  .brand-link:hover {
    text-decoration: none;
  }

  .brand-eyebrow {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--fg-brand);
  }

  .brand-divider {
    display: block;
    width: 1px;
    height: 22px;
    background: var(--border-soft);
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.25rem;
    color: var(--fg-1);
    font-variation-settings: "opsz" 24;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  /* ============================================================
     BUTTONS
     ============================================================ */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    padding: 9px 14px;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    border-radius: var(--r-sm);
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-standard),
                color var(--dur-fast) var(--ease-standard),
                border-color var(--dur-fast) var(--ease-standard);
  }

  .btn:hover {
    text-decoration: none;
  }

  .btn-primary {
    background: var(--carnelian);
    color: var(--white);
  }

  .btn-primary:hover {
    background: var(--carnelian-deep);
    color: var(--white);
  }

  .btn-secondary {
    background: transparent;
    color: var(--fg-1);
    border-color: var(--border-firm);
  }

  .btn-secondary:hover {
    background: rgba(18, 20, 23, 0.06);
    color: var(--fg-1);
  }

  .btn-secondary:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .btn-ghost {
    background: transparent;
    color: var(--fg-3);
    border-color: transparent;
    font-weight: 500;
    padding: 8px 12px;
    font-size: 0.875rem;
    font-family: var(--font-sans);
    cursor: pointer;
  }

  .btn-ghost:hover {
    background: rgba(18, 20, 23, 0.06);
    color: var(--fg-1);
    text-decoration: none;
  }

  /* ============================================================
     FORM ELEMENTS
     ============================================================ */
  input[type="text"],
  input[type="search"],
  input[type="email"],
  select,
  textarea {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--fg-1);
    background: var(--bg-2);
    border: 1px solid var(--border-soft);
    border-radius: var(--r-md);
    transition: border-color var(--dur-fast) var(--ease-standard),
                box-shadow var(--dur-fast) var(--ease-standard);
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--carnelian);
    box-shadow: 0 0 0 3px rgba(179, 27, 27, 0.12);
  }

  /* ============================================================
     TAGS / PILLS
     ============================================================ */
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 2px 7px;
    border-radius: var(--r-pill);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    white-space: nowrap;
    line-height: 1.6;
  }

  .tag-lang {
    background: rgba(179, 27, 27, 0.09);
    color: var(--carnelian-deep);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .tag-meta {
    background: var(--bg-3);
    color: var(--fg-4);
  }

  /* ============================================================
     LOADING SPINNER
     ============================================================ */
  .spinner {
    display: inline-block;
    width: 18px;
    height: 18px;
    border: 2px solid var(--border-soft);
    border-top-color: var(--carnelian);
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
    flex-shrink: 0;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* ============================================================
     SITE FOOTER
     ============================================================ */
  .site-footer {
    border-top: 1px solid var(--border-hair);
    padding: var(--sp-5) 0;
    margin-top: var(--sp-9);
  }

  .site-footer p {
    font-size: 0.8125rem;
    color: var(--fg-4);
    line-height: 1.5;
  }

  .site-footer a {
    color: var(--fg-3);
  }

  .site-footer a:hover {
    color: var(--fg-1);
  }

  /* ============================================================
     RESPONSIVE
     ============================================================ */
  @media (max-width: 768px) {
    .container,
    .container-wide {
      padding: 0 var(--sp-4);
    }

    .site-header {
      padding: var(--sp-3) var(--sp-4);
    }
  }
</style>
