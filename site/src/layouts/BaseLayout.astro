---
import AboutModal from '../components/AboutModal.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Searchable archive of urban climate adaptation and resilience plans' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | AdaptBase Plans</title>
    <!-- No webfonts: the type is Helvetica Neue / Helvetica / Arial. -->
  </head>
  <body>
    <header class="site-header">
      <div class="brand-link">
        <a href="/" class="brand-eyebrow">AdaptBase</a>
        <span class="brand-divider" aria-hidden="true"></span>
        <!-- The AdaptBase site switcher: the same block on search, plans and ontology. -->
        <details class="site-switch">
          <summary class="brand-name" aria-label="Plans. Switch AdaptBase site">Plans<svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
          <nav class="site-switch-menu" aria-label="AdaptBase sites">
            <a href="https://search.adaptbase.us/"><b>Graph</b><span>Search and explore the knowledge graph</span></a>
            <a href="https://plans.adaptbase.us/" aria-current="page"><b>Plans</b><span>The library of adaptation and resilience plans</span></a>
            <a href="https://ontology.adaptbase.us/"><b>Ontology</b><span>The types and relationships behind the graph</span></a>
            <hr />
            <a href="https://www.adaptbase.us/"><b>AdaptBase</b><span>About the project</span></a>
          </nav>
        </details>
      </div>
      <div class="header-actions">
        <button class="btn btn-primary btn-sm" id="submit-plan-button">Submit a Plan</button>
        <button class="btn-ghost" id="about-button">About</button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer-inner">
        <a href="https://urban.tech.cornell.edu/" target="_blank" rel="noopener noreferrer" class="footer-org">
          <img src="/jacobs-logo.png" alt="Jacobs Technion-Cornell Institute at Cornell Tech" class="footer-jacobs-logo" />
          <span class="footer-org-label">Urban Tech Hub</span>
        </a>
        <p class="footer-links">
          Part of <a href="https://adaptbase.us">AdaptBase</a> ·
          Powered by <a href="https://supabase.com">Supabase</a> &amp; <a href="https://astro.build">Astro</a>
        </p>
      </div>
    </footer>

    <AboutModal />

    <script>
      const aboutButton = document.getElementById('about-button');
      const submitPlanButton = document.getElementById('submit-plan-button');
      const modal = document.getElementById('about-modal');
      const modalClose = modal?.querySelector('.modal-close');
      const modalOverlay = modal?.querySelector('.modal-overlay');

      aboutButton?.addEventListener('click', () => {
        modal?.classList.add('active');
        modal?.setAttribute('aria-hidden', 'false');
      });

      submitPlanButton?.addEventListener('click', () => {
        (window as any).openSubmitPlanModal?.();
      });

      // The site switcher: close on a click outside or on Escape; opening and
      // keyboard use are the browser's own <details>/<summary> behaviour.
      document.querySelectorAll<HTMLDetailsElement>('details.site-switch').forEach((d) => {
        document.addEventListener('click', (e) => {
          if (d.open && !d.contains(e.target as Node)) d.open = false;
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && d.open) {
            d.open = false;
            d.querySelector('summary')?.focus();
          }
        });
      });

      const closeModal = () => {
        modal?.classList.remove('active');
        modal?.setAttribute('aria-hidden', 'true');
      };

      modalClose?.addEventListener('click', closeModal);
      modalOverlay?.addEventListener('click', closeModal);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal?.classList.contains('active')) {
          closeModal();
        }
      });
    </script>
  </body>
</html>

<style is:global>
  /* ============================================================
     DESIGN TOKENS
     2026-10-08: the AdaptBase sites share the Harvard deck's look
     (www.adaptbase.us/hbs-adaptation-finance-demo/): white ground,
     near-black Helvetica for everything (no webfonts), ink controls,
     and the deck's red kept for emphasis — the same choices as
     search.adaptbase.us (adaptbase-core packages/search/src/styles/tokens.css).
     The four font tokens survive so component CSS keeps working; they
     all resolve to one family now, labels included.
     ============================================================ */
  :root {
    /* Fonts */
    --font-display: "Helvetica Neue", Helvetica, Arial, sans-serif;
    --font-sans:    "Helvetica Neue", Helvetica, Arial, sans-serif;
    --font-mono:    "Helvetica Neue", Helvetica, Arial, sans-serif;
    --font-accent:  "Helvetica Neue", Helvetica, Arial, sans-serif;

    /* Brand: the deck's red (it replaced Cornell carnelian). For emphasis
       — the hero phrase, the wordmark accent, errors — not for controls. */
    --carnelian:        #D7263D;
    --carnelian-deep:   #B01E33;
    --carnelian-bright: #E4002B;
    --accent-rgb:       215, 38, 61;

    /* Neutrals (ink → white), the deck's */
    --ink:      #111111;
    --ink-2:    #333333;
    --graphite: #6B6B6B;
    --concrete: #8A8A8A;
    --mist:     #C7C7C7;
    --stone:    #E4E4E7;
    --fog:      #F4F4F5;
    --paper:    #FFFFFF;
    --paper-2:  #FFFFFF;
    --white:    #FFFFFF;

    /* Accents */
    --blueprint:        #1E4DD8;
    --blueprint-soft:   #D9E1F7;
    --sodium:           #F4A02C;
    --sodium-soft:      #FBE8C6;
    --chlorophyll:      #2E7D4F;
    --chlorophyll-soft: #D4E4D8;

    /* Semantic foreground/background */
    --fg-1:     var(--ink);
    --fg-2:     var(--ink-2);
    --fg-3:     var(--graphite);
    --fg-4:     var(--concrete);
    --fg-brand: var(--carnelian);
    --fg-link:  var(--ink);
    --bg-1:     var(--paper);
    --bg-2:     var(--paper-2);
    --bg-3:     var(--fog);
    --bg-4:     var(--stone);
    --bg-brand: var(--carnelian);

    /* Status */
    --status-success: var(--chlorophyll);

    /* Borders */
    --border-hair: rgba(0, 0, 0, 0.08);
    --border-soft: rgba(0, 0, 0, 0.12);
    --border-firm: rgba(0, 0, 0, 0.24);

    /* Shadows */
    --shadow-1: 0 1px 2px rgba(0,0,0,0.05);
    --shadow-2: 0 1px 2px rgba(0,0,0,0.05), 0 6px 16px -8px rgba(0,0,0,0.14);
    --shadow-3: 0 1px 2px rgba(0,0,0,0.04), 0 10px 28px -14px rgba(0,0,0,0.2);

    /* Spacing (4px base) */
    --sp-1:  0.25rem;
    --sp-2:  0.5rem;
    --sp-3:  0.75rem;
    --sp-4:  1rem;
    --sp-5:  1.5rem;
    --sp-6:  2rem;
    --sp-7:  3rem;
    --sp-8:  4rem;
    --sp-9:  6rem;
    --sp-10: 8rem;

    /* Radii */
    --r-sm:   2px;
    --r-md:   4px;
    --r-lg:   8px;
    --r-xl:   14px;
    --r-pill: 999px;

    /* Motion */
    --ease-standard: cubic-bezier(0.4, 0, 0.2, 1);
    --ease-out:      cubic-bezier(0.16, 1, 0.3, 1);
    --dur-fast: 120ms;
    --dur-base: 220ms;

    /* Backwards-compat aliases used in existing component CSS */
    --brand:       var(--carnelian);
    --brand-dark:  var(--carnelian-deep);
    --brand-light: var(--sodium-soft);
    --gray-50:     var(--paper);
    --gray-100:    var(--fog);
    --gray-200:    var(--stone);
    --gray-300:    var(--mist);
    --gray-600:    var(--concrete);
    --gray-700:    var(--graphite);
    --gray-800:    var(--ink-2);
    --gray-900:    var(--ink);
    --success:     var(--chlorophyll);
    --space-2:     var(--sp-2);
    --space-3:     var(--sp-3);
    --space-4:     var(--sp-4);
    --space-6:     var(--sp-5);
    --space-8:     var(--sp-6);
    --space-12:    var(--sp-7);
    --radius-sm:   var(--r-sm);
    --radius-md:   var(--r-md);
    --shadow-sm:   var(--shadow-1);
    --shadow-md:   var(--shadow-2);
    --font-ui:     var(--font-sans);
  }

  /* ============================================================
     RESET & BASE
     ============================================================ */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.5;
    color: var(--fg-1);
    background: var(--bg-1);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* ============================================================
     TYPOGRAPHY
     ============================================================ */
  /* Headings set bold and tight, as the deck sets its titles. */
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.12;
    color: var(--fg-1);
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    letter-spacing: -0.03em;
  }

  h2 {
    font-size: clamp(1.375rem, 3vw, 2rem);
    letter-spacing: -0.025em;
  }

  h3 {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 1.4;
  }

  p {
    color: var(--fg-2);
    line-height: 1.6;
  }

  a {
    color: var(--fg-link);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-standard);
  }

  a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--border-firm);
    text-underline-offset: 0.18em;
  }

  /* ============================================================
     LAYOUT
     ============================================================ */
  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--sp-5);
  }

  .container-wide {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 var(--sp-5);
  }

  main {
    flex: 1;
  }

  /* ============================================================
     SITE HEADER
     ============================================================ */
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--sp-3) var(--sp-5);
    background: var(--bg-1);
    border-bottom: 1px solid var(--border-hair);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    text-decoration: none;
  }

  .brand-link:hover {
    text-decoration: none;
  }

  a.brand-eyebrow,
  a.brand-eyebrow:hover {
    text-decoration: none;
  }

  /* ---- AdaptBase site switcher ----
     The site name beside the wordmark opens a menu of the AdaptBase sites.
     The same block is on search.adaptbase.us, plans.adaptbase.us and
     ontology.adaptbase.us (2026-10-08); colours are literal so it renders
     alike on all three. Size comes from .brand-name. */
  .site-switch { position: relative; }
  .site-switch > summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 6px;
    margin: -4px -6px;
    border-radius: 6px;
    user-select: none;
  }
  .site-switch > summary::-webkit-details-marker { display: none; }
  .site-switch > summary:hover,
  .site-switch[open] > summary { color: #111111; background: #f4f4f5; }
  .site-switch > summary:focus-visible { outline: 2px solid #111111; outline-offset: 2px; }
  .site-switch .chev { width: 0.5em; height: 0.5em; flex: none; transition: transform 0.15s ease; }
  .site-switch[open] .chev { transform: rotate(180deg); }
  .site-switch-menu {
    position: absolute;
    top: calc(100% + 10px);
    left: -6px;
    z-index: 300;
    min-width: 300px;
    padding: 6px;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 10px 28px -14px rgba(0, 0, 0, 0.2);
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    letter-spacing: normal;
    white-space: normal;
  }
  .site-switch-menu a {
    display: grid;
    gap: 2px;
    padding: 9px 12px;
    border-radius: 6px;
    color: #111111;
    text-decoration: none;
  }
  .site-switch-menu a:hover,
  .site-switch-menu a:focus-visible { background: #f4f4f5; outline: none; text-decoration: none; color: #111111; }
  .site-switch-menu b { font-size: 0.95rem; font-weight: 700; letter-spacing: -0.01em; line-height: 1.2; }
  .site-switch-menu span { font-size: 0.8rem; color: #6b6b6b; line-height: 1.35; }
  .site-switch-menu a[aria-current="page"] b::after { content: " · you are here"; font-weight: 400; font-size: 0.8rem; color: #6b6b6b; }
  .site-switch-menu hr { border: 0; border-top: 1px solid rgba(0, 0, 0, 0.08); margin: 6px 4px; }
  /* Narrow screens: the menu spans the width under the header instead of
     hanging off the site name, which ran it off the right edge. */
  @media (max-width: 560px) {
    .site-switch-menu {
      position: fixed;
      top: 58px;
      left: 12px;
      right: 12px;
      min-width: 0;
    }
  }

  /* The wordmark, as search.adaptbase.us sets it: "AdaptBase" bold and
     tight in ink, then the site's name in regular grey. */
  .brand-eyebrow {
    font-family: var(--font-sans);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--fg-1);
  }

  .brand-divider {
    display: block;
    width: 1px;
    height: 24px;
    background: var(--border-soft);
  }

  .brand-name {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 1.6rem;
    color: var(--fg-3);
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  /* ============================================================
     BUTTONS
     ============================================================ */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    padding: 9px 14px;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    border-radius: var(--r-sm);
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-standard),
                color var(--dur-fast) var(--ease-standard),
                border-color var(--dur-fast) var(--ease-standard);
  }

  .btn:hover {
    text-decoration: none;
  }

  /* Controls are ink, as on the search site; red is for emphasis. */
  .btn-primary {
    background: var(--ink);
    color: var(--white);
  }

  .btn-primary:hover {
    background: var(--ink-2);
    color: var(--white);
  }

  .btn-secondary {
    background: transparent;
    color: var(--fg-1);
    border-color: var(--border-firm);
  }

  .btn-secondary:hover {
    background: rgba(18, 20, 23, 0.06);
    color: var(--fg-1);
  }

  .btn-secondary:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .btn-ghost {
    background: transparent;
    color: var(--fg-3);
    border-color: transparent;
    font-weight: 500;
    padding: 8px 12px;
    font-size: 0.875rem;
    font-family: var(--font-sans);
    cursor: pointer;
  }

  .btn-ghost:hover {
    background: rgba(18, 20, 23, 0.06);
    color: var(--fg-1);
    text-decoration: none;
  }

  .btn-sm {
    padding: 7px 12px;
    font-size: 0.8125rem;
  }

  /* ============================================================
     FORM ELEMENTS
     ============================================================ */
  input[type="text"],
  input[type="search"],
  input[type="email"],
  select,
  textarea {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--fg-1);
    background: var(--bg-2);
    border: 1px solid var(--border-soft);
    border-radius: var(--r-md);
    transition: border-color var(--dur-fast) var(--ease-standard),
                box-shadow var(--dur-fast) var(--ease-standard);
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    /* No focus ring (2026-10-08): the caret marks focus; the border only
       firms up a shade. */
    border-color: var(--border-firm);
  }

  /* ============================================================
     TAGS / PILLS
     ============================================================ */
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 2px 7px;
    border-radius: var(--r-pill);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    white-space: nowrap;
    line-height: 1.6;
  }

  .tag-lang {
    background: var(--fog);
    color: var(--fg-2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .tag-meta {
    background: var(--bg-3);
    color: var(--fg-4);
  }

  /* ============================================================
     LOADING SPINNER
     ============================================================ */
  .spinner {
    display: inline-block;
    width: 18px;
    height: 18px;
    border: 2px solid var(--border-soft);
    border-top-color: var(--ink);
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
    flex-shrink: 0;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* ============================================================
     SITE FOOTER
     ============================================================ */
  .site-footer {
    border-top: 1px solid var(--border-hair);
    padding: var(--sp-6) 0;
    margin-top: var(--sp-9);
  }

  .site-footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    flex-wrap: wrap;
  }

  .footer-org {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    text-decoration: none;
    flex-shrink: 0;
  }

  .footer-org:hover {
    text-decoration: none;
  }

  .footer-jacobs-logo {
    height: 64px;
    width: auto;
    display: block;
    opacity: 0.75;
    transition: opacity var(--dur-fast) var(--ease-standard);
  }

  .footer-org:hover .footer-jacobs-logo {
    opacity: 1;
  }

  .footer-org-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-4);
    padding-left: var(--sp-4);
    border-left: 1px solid var(--border-hair);
    transition: color var(--dur-fast) var(--ease-standard);
  }

  .footer-org:hover .footer-org-label {
    color: var(--fg-2);
  }

  .footer-links {
    font-size: 0.8125rem;
    color: var(--fg-4);
    line-height: 1.5;
  }

  .site-footer a {
    color: var(--fg-3);
  }

  .site-footer a:hover {
    color: var(--fg-1);
  }

  @media (max-width: 600px) {
    .site-footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* ============================================================
     RESPONSIVE
     ============================================================ */
  @media (max-width: 768px) {
    .container,
    .container-wide {
      padding: 0 var(--sp-4);
    }

    .site-header {
      padding: var(--sp-3) var(--sp-4);
    }
  }
</style>
