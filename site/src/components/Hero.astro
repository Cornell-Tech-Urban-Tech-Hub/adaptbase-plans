---
interface Props {
  stats?: {
    totalDocuments: number;
    totalCountries: number;
    totalCities: number;
  };
}

const { stats } = Astro.props;
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-headline">
      <h1>A searchable archive of <em>urban climate adaptation and resilience plans.</em></h1>
    </div>
    <div class="hero-detail">
      {stats && (
        <div class="hero-stats">
          <div class="stat">
            <span class="num">{stats.totalDocuments.toLocaleString()}</span>
            <span class="lbl">Plans</span>
          </div>
          <div class="stat">
            <span class="num">{stats.totalCities.toLocaleString()}</span>
            <span class="lbl">Cities</span>
          </div>
          <div class="stat">
            <span class="num">{stats.totalCountries.toLocaleString()}</span>
            <span class="lbl">Countries</span>
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--bg-1);
    border-bottom: 1px solid var(--border-hair);
    padding: var(--sp-8) 0 var(--sp-6);
  }

  .hero-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 var(--sp-5);
  }

  .hero-headline h1 {
    max-width: 820px;
    margin-bottom: var(--sp-5);
  }

  .hero-headline em {
    color: var(--fg-brand);
    font-style: normal;
  }

  .hero-stats {
    display: flex;
    gap: var(--sp-7);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--border-hair);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .stat .num {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 500;
    font-variation-settings: "opsz" 48;
    color: var(--fg-brand);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .stat .lbl {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--fg-4);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  @media (max-width: 768px) {
    .hero {
      padding: var(--sp-6) 0 var(--sp-5);
    }

    .hero-inner {
      padding: 0 var(--sp-4);
    }

    .hero-stats {
      gap: var(--sp-5);
    }

    .stat .num {
      font-size: 1.5rem;
    }
  }
</style>
