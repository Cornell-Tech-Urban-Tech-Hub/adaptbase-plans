---
---

<section class="hero">
  <div class="hero-inner">
    <h1>A searchable archive of <em class="red">urban climate adaptation and resilience plans.</em></h1>
    <div class="hero-lower">
      <p class="hero-desc">A curated collection of strategies from cities around the world, assembled by the Urban Tech Hub at Cornell Tech. Browse by location, language, or keyword — or use semantic search to find plans relevant to your work.</p>
      <div class="hero-stats">
        <div class="stat">
          <span class="num" id="stat-plans">—</span>
          <span class="lbl">Plans</span>
        </div>
        <div class="stat">
          <span class="num" id="stat-cities">—</span>
          <span class="lbl">Cities</span>
        </div>
        <div class="stat">
          <span class="num" id="stat-countries">—</span>
          <span class="lbl">Countries</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--bg-1);
    border-bottom: 1px solid var(--border-hair);
    padding: var(--sp-8) 0 var(--sp-7);
  }

  .hero-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 var(--sp-5);
  }

  .hero-inner h1 {
    margin-bottom: var(--sp-6);
  }

  .red {
    color: var(--fg-brand);
    font-style: normal;
  }

  .hero-lower {
    display: flex;
    gap: var(--sp-8);
    align-items: center;
    padding-top: var(--sp-5);
    border-top: 1px solid var(--border-hair);
  }

  .hero-desc {
    font-size: 1rem;
    color: var(--fg-3);
    line-height: 1.65;
    max-width: 56ch;
    flex: 1 1 auto;
    min-width: 0;
  }

  .hero-stats {
    display: flex;
    gap: var(--sp-7);
    flex-shrink: 0;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .stat .num {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 500;
    font-variation-settings: "opsz" 48;
    color: var(--fg-brand);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .stat .lbl {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--fg-4);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  @media (max-width: 900px) {
    .hero-lower {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--sp-5);
    }

    .hero-stats {
      gap: var(--sp-6);
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: var(--sp-6) 0 var(--sp-5);
    }

    .hero-inner {
      padding: 0 var(--sp-4);
    }

    .stat .num {
      font-size: 1.5rem;
    }
  }
</style>
